# Sherlock - Environment Configuration
# Copy this file to .env.local and add keys for local development only.
# For a public BYOK deployment, keep shared host env vars unset and enter keys in-app per browser.

# Default provider: YRKA (Agency gateway, free models). Token is BYOK per browser;
# env vars are only a fallback for local dev / trusted deploys.
VITE_YRKA_GATEWAY_TOKEN=your_yrka_gateway_token_here

# MCP web-search gateway (you_search primary, tavily fallback). Falls back to
# VITE_YRKA_GATEWAY_TOKEN when unset.
VITE_YRKA_MCP_GATEWAY_TOKEN=your_yrka_mcp_gateway_token_here

# Optional overrides (defaults live in src/services/providers/yrkaProvider.ts)
# YRKA_API_URL=https://gateway.yrka.io/v1/chat/completions
# YRKA_MODELS_API_URL=https://gateway.yrka.io/v1/models

# Deepgram TTS — audio briefings (free-credit account). Preferred TTS lane;
# falls back to Gemini TTS when unset.
VITE_DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Alternative providers (optional BYOK lanes)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
# VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here
# VITE_OPENAI_API_KEY=your_openai_api_key_here
# VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# tldraw SDK license key for local testing or deployments using tldraw 4.x.
# Keep this in local env or host env config, not in Sherlock's Runtime settings UI.
# VITE_TLDRAW_LICENSE_KEY=your_tldraw_license_key_here
